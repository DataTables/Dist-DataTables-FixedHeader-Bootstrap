<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>5.1.0</version>
        <id>datatables.net-fixedheader-bs</id>
        <description>This is FixedHeader for DataTables with styling for [Bootstrap](https://getbootstrap.com/docs/3.3/)</description>
        <repository type="git" url="https://github.com/DataTables/FixedHeader"/>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>http://datatables.net</projectUrl>
        <license type="expression">MIT</license>
        <tags>FixedHeader  Fixed Headers  Sticky  Bootstrap  Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-fixedheader" version="5.1.0"/>
            <dependency id="datatables.net-bs" version="^3.1"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/fixedHeader.bootstrap.js" target="content\Scripts"/>
        <file src="js/fixedHeader.bootstrap.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/fixedHeader.bootstrap.min.js" target="content\Scripts"/>
        <file src="js/fixedHeader.bootstrap.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/fixedHeader.bootstrap.min.mjs" target="content\Scripts"/>
        <file src="js/fixedHeader.bootstrap.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/fixedHeader.bootstrap.mjs" target="content\Scripts"/>
        <file src="js/fixedHeader.bootstrap.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/fixedHeader.bootstrap.css" target="content\Content"/>
        <file src="css/fixedHeader.bootstrap.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/fixedHeader.bootstrap.min.css" target="content\Content"/>
        <file src="css/fixedHeader.bootstrap.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
